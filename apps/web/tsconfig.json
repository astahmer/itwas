{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "paths": {
      "kumo-ui": [
        "./node_modules/kumo-ui/dist/index.d.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ]
}